# Variables de entorno para Plantilla de Ventas
# Copia este archivo a .env.local (desarrollo) o configura las mismas en Vercel (producción)

# Email de la Google Service Account (se ve en Google Cloud Console > IAM > Service Accounts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=plantilla-ventas@mi-proyecto-123456.iam.gserviceaccount.com

# Private key de la Service Account (descargada del JSON de credenciales)
# IMPORTANTE: copiar tal cual, con los saltos de línea escapados como \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEF...\n-----END PRIVATE KEY-----\n"

# ID del Google Sheet (se saca de la URL)
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SHEET_ID=1ABC...xyz123456

# Secreto para firmar las cookies de sesión (cadena aleatoria larga)
# Puedes generar una con: openssl rand -hex 32
AUTH_SECRET=cambia-esto-por-una-cadena-aleatoria-larga-de-al-menos-32-caracteres
